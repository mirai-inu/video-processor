# Backend API (BFF からの接続先)
NEXT_PUBLIC_API_URL=http://localhost:3001

# 認証 (NextAuth v5 / Auth.js)
# AUTH_SECRET は `openssl rand -base64 33` などで生成する
AUTH_SECRET=
# Google OAuth クライアント (Google Cloud Console で発行)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ログインを許可するメールドメイン (カンマ区切りで複数可)。未設定は fail-closed = 誰も入れない
ALLOWED_DOMAINS=team-mir.ai

# ローカル開発用の dummy ログイン。Google OAuth なしでログインできる。
# !!! 本番では絶対に設定しない (true にすると誰でもログインできてしまう) !!!
# AUTH_DUMMY_ENABLED=true
